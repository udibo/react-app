{
  "name": "@udibo/react-app",
  "version": "0.25.0",
  "exports": {
    ".": "./mod.tsx",
    "./build": "./build.ts",
    "./dev": "./dev.ts",
    "./client": "./client.tsx",
    "./server": "./server.tsx",
    "./test-utils": "./test-utils.ts",
    "./global-jsdom": "./global-jsdom.ts"
  },
  "publish": {
    "include": [
      "LICENSE",
      "**/*.json",
      "**/*.jsonc",
      "**/*.md",
      "**/*.ts",
      "**/*.tsx"
    ],
    "exclude": [
      "**/*.test.ts",
      "**/*.test.tsx",
      "test-utils.tsx",
      "example",
      "coverage",
      "node_modules"
    ]
  },
  "tasks": {
    "build": {
      "description": "Builds the application in production mode.",
      "command": "cd ./example && deno task build"
    },
    "run": {
      "description": "Runs the application in production mode. Requires the application to be built first.",
      "command": "cd ./example && deno task run"
    },
    "dev": {
      "description": "Builds and runs the application in development mode, with hot reloading.",
      "command": "cd ./example && deno task dev"
    },
    "test": {
      "description": "Runs the tests.",
      "command": "deno test -A --trace-leaks --env-file=example/.env --env-file=example/.env.test"
    },
    "test-watch": {
      "description": "Runs the tests in watch mode.",
      "command": "deno task test --watch"
    },
    "check": {
      "description": "Checks the formatting and runs the linter.",
      "command": "deno lint && deno fmt --check"
    },
    "git-rebase": {
      "description": "Gets your branch up to date with master after a squash merge.",
      "command": "git fetch origin main && git rebase --onto origin/main HEAD"
    },
    "start-dev": {
      "description": "Starts the development services.",
      "command": "cd ./example && deno task start-dev"
    },
    "start-test": {
      "description": "Starts the test services.",
      "command": "cd ./example && deno task start-test"
    },
    "start": {
      "description": "Starts the development and test services.",
      "command": "cd ./example && deno task start"
    },
    "stop-dev": {
      "description": "Stops the development services.",
      "command": "cd ./example && deno task stop-dev"
    },
    "stop-test": {
      "description": "Stops the test services.",
      "command": "cd ./example && deno task stop-test"
    },
    "stop": {
      "description": "Stops the development and test services.",
      "command": "cd ./example && deno task stop"
    }
  },
  "compilerOptions": {
    "lib": ["esnext", "dom", "dom.iterable", "dom.asynciterable", "deno.ns"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "jsxImportSourceTypes": "@types/react"
  },
  "exclude": [
    "coverage",
    "node_modules",
    "example/public/build",
    "example/routes/_main.ts",
    "example/routes/_main.tsx"
  ],
  "nodeModulesDir": "auto",
  "imports": {
    "@udibo/http-error": "jsr:@udibo/http-error@^0.9",
    "@udibo/esbuild-plugin-postcss": "jsr:@udibo/esbuild-plugin-postcss@^0.2",
    "@luca/esbuild-deno-loader": "jsr:@kylejune/esbuild-deno-loader@^0.12",
    "@oak/oak": "jsr:@oak/oak@17",
    "@std/assert": "jsr:@std/assert@1",
    "@std/async": "jsr:@std/async@1",
    "@std/fs": "jsr:@std/fs@1",
    "@std/log": "jsr:@std/log@0",
    "@std/path": "jsr:@std/path@1",
    "@std/testing": "jsr:@std/testing@1",
    "esbuild": "npm:esbuild@^0.24",
    "react": "npm:react@18",
    "@types/react": "npm:@types/react@18",
    "react-dom": "npm:react-dom@18",
    "react-error-boundary": "npm:react-error-boundary@4",
    "react-router": "npm:react-router@7",
    "react-helmet-async": "npm:react-helmet-async@2",
    "serialize-javascript": "npm:serialize-javascript@6",
    "@testing-library/react": "npm:@testing-library/react@16",
    "global-jsdom": "npm:global-jsdom@25"
  }
}
